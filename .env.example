SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

BOT_SMTP_HOST=smtp.gmail.com
BOT_SMTP_PORT=465
BOT_SMTP_USER=bot@example.com
BOT_SMTP_PASS=your-app-password

BOT_IMAP_HOST=imap.gmail.com
BOT_IMAP_PORT=993
BOT_IMAP_USER=bot@example.com
BOT_IMAP_PASS=your-app-password

PRODUCT_CATEGORY=protein
PRODUCT_URL_BASE=https://shop.amul.com

# Preferred structured config. Each target maps recipients to one pincode.
RECIPIENT_TARGETS=[{"pincode":"122004","recipients":["alice@example.com"]},{"pincode":"110001","recipients":["bob@example.com","team@example.com"]}]

# Legacy fallback. Only needed if RECIPIENT_TARGETS is not provided.
EMAIL_TO=alice@example.com
PINCODE=122004

LOW_STOCK_THRESHOLD=10
REPLY_LOOKBACK_HOURS=72
IMAP_MAILBOX=INBOX
PRODUCT_REQUEST_TIMEOUT_MS=15000
DRY_RUN=false
